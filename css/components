/* Cards */
.card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 35px;
    transition: .3s;
}

.card:hover {
    transform: translateY(-10px) scale(1.03);
    border-color: var(--cyan);
    box-shadow:
        0 0 15px rgba(0, 229, 255, .3),
        0 0 35px rgba(187, 134, 252, .2);
}


/* Tech Tags */
.tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 25px;
}

.tech-tags span {
    padding: 8px 14px;
    border-radius: 25px;
    background: #0D1117;
    border: 1px solid var(--border);
    color: var(--cyan);
    font-size: .9rem;
}


/* Progress Bar */
.progress-bar {
    height: 10px;
    background: #0D1117;
    border-radius: 5px;
    margin-top: 20px;
}

.progress-bar-fill {
    height: 100%;
    background: var(--cyan);
    border-radius: 5px;
}

/* Page Header */
.page-header {
    padding-top: 50px;
    padding-bottom: 80px;
    text-align: center;
}

.page-header h1 {
    font-size: 3.8rem;
    color: var(--purple);
    margin-bottom: 20px;
}

.page-header p {
    max-width: 700px;
    margin: auto;
    font-size: 1.15rem;
    color: var(--grey);
}

/* Back Link */
.back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 40px;
    color: var(--cyan);
    font-weight: 500;
    transition: .3s;
}

.back-link:hover {
    transform: translateX(-6px);
}

/* Contact Cards */
.contact-cards {
    display: flex;
    justify-content: center;
    gap: 25px;
    flex-wrap: wrap;
    margin-top: 50px;

}

.contact-card {
    background: #0D1117;
    padding: 30px;
    width: 250px;
    border-radius: 15px;
    border: 1px solid #2d333b;
    transition: .3s;
}

.contact-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 0 25px #00E5FF;
}

.contact-card h3 {
    color: #00E5FF;
}

.contact-button {
    display: inline-block;
    margin-top: 15px;
    padding: 10px 20px;
    border-radius: 8px;
    background: #BB86FC;
    color: white;
    text-decoration: none;
    font-size: 15px;
    transition: .3s;
}

.contact-button:hover {
    background: #00E5FF;
    color: #0D1117;
    box-shadow: 0 0 20px #00E5FF;
}

/* time-line */
.timeline {
    margin-top: 50px;
}